{
  "name": "maroon-traceability-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --cache --cache-location node_modules/.cache/eslint --fix --max-warnings=0 --no-warn-ignored"
  },
  "scripts": {
    "prepare": "node -e \"try{require('fs').accessSync('.git');require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "dev": "cross-env TURBOPACK=0 NODE_ENV=development next dev",
    "build": "cross-env TURBOPACK=0 next build",
    "build:export": "cross-env TURBOPACK=0 next build",
    "export": "next export",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "build:analyze": "cross-env ANALYZE=true next build",
    "build:production": "cross-env NODE_ENV=production next build",
    "build:profile": "cross-env NODE_ENV=production next build --profile",
    "clean": "rm -rf .next out dist",
    "dev:turbo": "next dev --turbo",
    "perf:analyze": "npm run build:analyze",
    "perf:bundle": "webpack-bundle-analyzer .next/static/chunks/",
    "perf:size": "size-limit --limit 244KB",
    "perf:check": "npm run type-check && npm run lint && npm run build",
    "test:registration-fix": "tsx --env-file=.env.local scripts/test/testRegistrationFix.ts",
    "diagnose:supabase": "tsx --env-file=.env.local scripts/deploy/diagnoseSupabase.ts",
    "diagnose:simple": "node scripts/utils/simpleDiagnose.cjs",
    "test:supabase-auth": "node scripts/test/testSupabaseAuth.cjs",
    "check:database": "node scripts/utils/checkDatabaseStatus.cjs",
    "test:auth-settings": "node scripts/test/testAuthSettings.cjs",
    "diagnose:deep": "node scripts/utils/deepDiagnostic.cjs",
    "test:minimal": "node scripts/test/minimalTest.cjs",
    "test:full-registration": "node scripts/test/testFullRegistration.cjs",
    "cleanup:dry-run": "tsx scripts/cleanup/repositoryCleanup.ts",
    "cleanup:execute": "tsx scripts/cleanup/repositoryCleanup.ts --execute",
    "cleanup:build": "tsx scripts/cleanup/repositoryCleanup.ts --build --execute",
    "cleanup:logs": "tsx scripts/cleanup/repositoryCleanup.ts --logs --execute",
    "cleanup:all": "tsx scripts/cleanup/repositoryCleanup.ts --build --logs --naming --duplicates --execute",
    "docs:consolidate": "tsx scripts/cleanup/documentationConsolidation.ts",
    "docs:consolidate:execute": "tsx scripts/cleanup/documentationConsolidation.ts --execute"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "@types/qrcode": "^1.5.6",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.6",
    "uuid": "^14.0.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@next/bundle-analyzer": "^15.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/testing-library__react": "^10.0.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.23",
    "compression": "^1.7.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.1.11",
    "eslint-plugin-testing-library": "^7.15.4",
    "eslint-plugin-unused-imports": "^4.0.0",
    "glob": "^13.0.6",
    "husky": "^9.0.11",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "size-limit": "^11.0.0",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "webpack-bundle-analyzer": "^4.10.1",
    "zlib": "^1.0.5"
  }
}
