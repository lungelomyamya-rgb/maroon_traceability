{
  "name": "maroon-traceability-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix --max-warnings=0 --no-warn-ignored"
  },
  "scripts": {
    "prepare": "node -e \"try{require('fs').accessSync('.git');require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "dev": "cross-env TURBOPACK=0 NODE_ENV=development next dev",
    "build": "cross-env TURBOPACK=0 next build",
    "build:export": "cross-env TURBOPACK=0 next build",
    "export": "next export",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "build:analyze": "cross-env ANALYZE=true next build",
    "build:production": "cross-env NODE_ENV=production next build",
    "build:profile": "cross-env NODE_ENV=production next build --profile",
    "clean": "rm -rf .next out dist",
    "dev:turbo": "next dev --turbo",
    "perf:analyze": "npm run build:analyze",
    "perf:bundle": "webpack-bundle-analyzer .next/static/chunks/",
    "perf:lighthouse": "lighthouse --output html --output-path ./lighthouse-report",
    "perf:size": "size-limit --limit 244KB",
    "perf:check": "npm run type-check && npm run lint && npm run build",
    "deduplicate:plan": "node scripts/deduplicate-repo.cjs plan",
    "deduplicate:backup": "node scripts/deduplicate-repo.cjs backup",
    "deduplicate:execute": "node scripts/deduplicate-repo.cjs execute",
    "deduplicate:execute-confirm": "node scripts/deduplicate-repo.cjs execute-confirm",
    "structural:dedup": "node scripts/structural-deduplication.cjs",
    "structural:dedup:plan": "node scripts/structural-deduplication.cjs plan",
    "structural:dedup:backup": "node scripts/structural-deduplication.cjs backup",
    "structural:dedup:execute": "node scripts/structural-deduplication.cjs execute",
    "structural:dedup:execute-confirm": "node scripts/structural-deduplication.cjs execute-confirm",
    "fix:imports": "node scripts/fix-imports.cjs",
    "fix:imports:dry-run": "node scripts/fix-imports.cjs dry-run",
    "fix:imports:fix": "node scripts/fix-imports.cjs fix",
    "test:registration-fix": "tsx scripts/testRegistrationFix.ts",
    "diagnose:supabase": "tsx scripts/diagnoseSupabase.ts",
    "test:simple-registration": "tsx scripts/testSimpleRegistration.ts",
    "diagnose:simple": "node scripts/simpleDiagnose.cjs",
    "test:supabase-auth": "node scripts/testSupabaseAuth.cjs",
    "check:database": "node scripts/checkDatabaseStatus.cjs",
    "test:auth-settings": "node scripts/testAuthSettings.cjs",
    "diagnose:deep": "node scripts/deepDiagnostic.cjs",
    "test:minimal": "node scripts/minimalTest.cjs",
    "test:full-registration": "node scripts/testFullRegistration.cjs",
    "cleanup:dry-run": "tsx scripts/cleanup/repositoryCleanup.ts",
    "cleanup:execute": "tsx scripts/cleanup/repositoryCleanup.ts --execute",
    "cleanup:build": "tsx scripts/cleanup/repositoryCleanup.ts --build --execute",
    "cleanup:logs": "tsx scripts/cleanup/repositoryCleanup.ts --logs --execute",
    "cleanup:all": "tsx scripts/cleanup/repositoryCleanup.ts --build --logs --naming --duplicates --execute",
    "docs:consolidate": "tsx scripts/cleanup/documentationConsolidation.ts",
    "docs:consolidate:execute": "tsx scripts/cleanup/documentationConsolidation.ts --execute"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.100.1",
    "@tanstack/react-query": "^5.18.1",
    "@types/qrcode": "^1.5.6",
    "chart.js": "^4.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "next": "^16.1.0",
    "next-themes": "^0.4.6",
    "node-fetch": "^2.7.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.68.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.6",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@next/bundle-analyzer": "^16.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/testing-library__react": "^10.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "autoprefixer": "^10.5.4",
    "compression": "^1.7.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-testing-library": "^7.15.4",
    "eslint-plugin-unused-imports": "^4.0.0",
    "glob": "^13.0.6",
    "husky": "^9.0.11",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2",
    "webpack-bundle-analyzer": "^5.3.2",
    "zlib": "^1.0.5"
  }
}
